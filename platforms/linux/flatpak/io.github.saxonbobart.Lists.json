{
    "_comment": "placeholder — see ../README.md",
    "app-id": "io.github.saxonbobart.Lists",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.vala"
    ],
    "command": "lists",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.background.Monitor",
        "--filesystem=xdg-data/lists:create",
        "--filesystem=xdg-documents:rw"
    ],
    "modules": [
        {
            "name": "libfyaml",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/pantoniou/libfyaml.git",
                    "tag": "v0.9"
                }
            ]
        },
        {
            "name": "blueprint-compiler",
            "buildsystem": "meson",
            "cleanup": ["*"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler.git",
                    "tag": "v0.16.0"
                }
            ]
        },
        {
            "name": "lists",
            "buildsystem": "meson",
            "config-opts": ["-Dprofile=default"],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
